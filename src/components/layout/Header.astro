---
import Button from "../common/Button.astro";
import Navbar from "./Navbar.astro";
import { Image } from "astro:assets";
import Logo from "../../assets/old/logos/GOM-Advogados-Logo.png";
---

<header class="site-header" id="topo">
  <div class="header-container">
    <!-- Logo -->
    <a href="#topo" class="logo" id="logo-link">
      <div class="logo-container">
        <Image
          src={Logo}
          alt="GOM Advogados"
          widths={[200, 400, 800]}
          sizes="(min-width: 1024px) 400px, (min-width: 480px) 300px, 200px"
          class="logo-site"
        />
      </div>
    </a>

    <!-- Desktop Navigation Component -->
    <Navbar />

    <!-- Header CTA Button & Hamburger -->
    <div class="header-actions">
      <div class="desktop-cta">
        <Button
          variant="outline"
          icon="calendar"
          text="AGENDAR REUNIÃO"
          href="https://wa.me/554730457491?text=Ol%C3%A1,%20gostaria%20de%20agendar%20uma%20reuni%C3%A3o."
        />
      </div>

      <!-- Hamburger Menu Button (Mobile Only) -->
      <button class="hamburger-btn" aria-label="Abrir Menu">
        <svg
          viewBox="0 0 24 24"
          width="26"
          height="26"
          fill="none"
          stroke="var(--color-gold)"
          stroke-width="2"
          stroke-linecap="round"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Mobile Sticky Header script to add solid black background on scroll
  const header = document.querySelector(".site-header");
  if (header) {
    window.addEventListener("scroll", () => {
      if (window.scrollY > 20) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }
    });
  }

  // Smooth scroll to top when clicking logo without page reload
  const logoLink = document.getElementById("logo-link");
  if (logoLink) {
    logoLink.addEventListener("click", (e) => {
      e.preventDefault();
      window.scrollTo({
        top: 0,
        behavior: "smooth",
      });
      history.pushState(null, "", "#topo");
    });
  }
</script>

<style>
  /* Mobile First Base Styles */
  .logo-site {
    width: 180px;
    height: auto;
    display: block;
    transition: width 0.3s ease;
  }

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: linear-gradient(
      180deg,
      rgba(10, 11, 13, 0.9) 0%,
      rgba(10, 11, 13, 0.45) 65%,
      rgba(10, 11, 13, 0) 100%
    );
    border-bottom: none;
    padding: 16px 0;
    z-index: 1000;
    transition:
      background-color 0.3s ease,
      background 0.3s ease,
      padding 0.3s ease,
      box-shadow 0.3s ease;
  }

  .site-header.scrolled {
    background-color: #0a0b0d !important;
    background: #0a0b0d !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
    padding: 12px 0;
  }

  .header-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo Styles */
  .logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .desktop-cta {
    display: none;
  }

  /* Hamburger Menu Button (Visible on Mobile/Tablet) */
  .hamburger-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    border-radius: 4px;
    transition: background-color 0.3s ease;
  }

  .hamburger-btn:hover {
    background-color: rgba(200, 162, 97, 0.1);
  }

  /* Tablet Enhancements (min-width: 640px) */
  @media (min-width: 640px) {
    .desktop-cta {
      display: block;
    }

    .logo-site {
      width: 200px;
    }
  }

  /* Desktop Enhancements (min-width: 1024px) */
  @media (min-width: 1024px) {
    .site-header {
      padding: 24px 0;
    }

    .site-header.scrolled {
      padding: 14px 0;
    }

    .site-header.scrolled .logo-site {
      width: 200px;
    }

    .header-container {
      padding: 0 32px;
    }

    .hamburger-btn {
      display: none;
    }
  }
</style>
