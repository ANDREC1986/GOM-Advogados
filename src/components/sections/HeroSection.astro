---
import { Image } from "astro:assets";
import Button from "../common/Button.astro";
import escritorioImg from "../../assets/escritorio.png";
---

<section class="hero-section" id="hero">
  <!-- Layer 1: Background Image & Gradient Overlay -->
  <div class="hero-visual">
    <Image
      src={escritorioImg}
      alt="Escritório GOM Advogados Associados"
      widths={[400, 800, 1200, 1600]}
      sizes="(min-width: 1024px) 580px, 100vw"
      class="hero-bg-image"
    />
    <div class="hero-overlay"></div>
  </div>

  <!-- Layer 2: Foreground Content Container -->
  <div class="hero-container">
    <div class="hero-content">
      <!-- Constrained Text Wrapper -->
      <div class="hero-text-wrapper">
        <div class="hero-subtitle">
          <span class="subtitle-line"></span>
          <span class="subtitle-text">EXCELÊNCIA. ESTRATÉGIA. RESULTADOS.</span>
        </div>

        <h1 class="hero-title">
          Soluções jurídicas estratégicas para proteger o que mais importa.
        </h1>

        <p class="hero-description">
          Atuamos de forma preventiva e contenciosa, com foco em empresas e
          pessoas que buscam segurança, tranquilidade e melhores resultados.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="hero-actions">
        <Button
          variant="gold"
          icon="whatsapp"
          text="FALAR NO WHATSAPP"
          href="https://wa.me/554730457491"
        />
        <Button
          variant="outline"
          icon="calendar"
          text="AGENDAR REUNIÃO"
          href="https://wa.me/554730457491?text=Ol%C3%A1,%20gostaria%20de%20agendar%20uma%20reuni%C3%A3o."
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Mobile First Base Styles */
  .hero-section {
    position: relative;
    width: 100%;
    min-height: 540px;
    background-color: var(--color-bg-dark);
    padding: 110px 0 60px 0;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* Layer 1: Background Visual Container */
  .hero-visual {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Gradient Overlay over image */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(10, 11, 13, 0.65) 0%,
      rgba(10, 11, 13, 0.45) 100%
    );
  }

  /* Layer 2: Main Content Container */
  .hero-container {
    position: relative;
    z-index: 10;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
  }

  /* Text Content Column */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 100%;
  }

  /* Constrained Text Container for Mobile */
  .hero-text-wrapper {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 380px;
  }

  .hero-subtitle {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .subtitle-line {
    width: 24px;
    height: 1.5px;
    background-color: var(--color-gold);
    display: inline-block;
  }

  .subtitle-text {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-gold);
    text-transform: uppercase;
  }

  .hero-title {
    font-family: var(--font-serif-display);
    font-size: 1.65rem;
    font-weight: 600;
    line-height: 1.22;
    color: var(--color-text-white);
    letter-spacing: -0.01em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .hero-description {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 400;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 16px;
    margin-top: 4px;
  }

  .hero-actions :global(.btn) {
    width: 100%;
  }

  /* Tablet Enhancements (min-width: 640px) */
  @media (min-width: 640px) {
    .hero-section {
      min-height: 580px;
    }

    .hero-overlay {
      background: linear-gradient(
        180deg,
        rgba(10, 11, 13, 0.85) 0%,
        rgba(10, 11, 13, 0.75) 100%
      );
    }

    .hero-container {
      padding: 0 32px;
    }

    .hero-content {
      gap: 24px;
    }

    .hero-text-wrapper {
      max-width: 540px;
      gap: 18px;
    }

    .subtitle-line {
      width: 32px;
    }

    .subtitle-text {
      font-size: 0.76rem;
      letter-spacing: 0.22em;
    }

    .hero-title {
      font-size: 2.6rem;
    }

    .hero-description {
      font-size: 1.05rem;
    }

    .hero-actions {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }

    .hero-actions :global(.btn) {
      width: auto;
    }
  }

  /* Desktop Enhancements (min-width: 1024px) */
  @media (min-width: 1024px) {
    .hero-section {
      min-height: 620px;
      padding: 150px 0 95px 0;
    }

    /* Fixed 580px width visual layer anchored to the right side on desktop */
    .hero-visual {
      left: auto;
      right: 0;
      width: 1200px;
      height: 100%;
      object-position: unset;
    }

    /* Horizontal gradient blending desktop text section into the image */
    .hero-overlay {
      background: linear-gradient(
        90deg,
        #0a0b0d 0%,
        rgba(10, 11, 13, 0.85) 45%,
        rgba(10, 11, 13, 0.2) 100%
      );
    }

    .hero-content {
      max-width: 620px;
    }

    .hero-text-wrapper {
      max-width: 100%;
    }

    .hero-title {
      font-size: 3.2rem;
    }
  }
</style>
