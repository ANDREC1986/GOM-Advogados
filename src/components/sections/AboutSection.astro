---
import { Image } from "astro:assets";
import ValueItem from "../common/ValueItem.astro";
import Title from "../common/Title.astro";
import recepcaoImg from "../../assets/recepcao.png";

const values = [
  {
    icon: "shield-check" as const,
    title: "ÉTICA",
    description:
      "Agimos com integridade, transparência e respeito em todas as relações.",
  },
  {
    icon: "people" as const,
    title: "COMPROMISSO",
    description:
      "Dedicação total aos objetivos e resultados dos nossos clientes.",
  },
  {
    icon: "target" as const,
    title: "ESTRATÉGIA",
    description:
      "Soluções jurídicas inteligentes, alinhadas a cada necessidade.",
  },
  {
    icon: "award" as const,
    title: "EXCELÊNCIA",
    description: "Padrões elevados de atuação e constante busca por evolução.",
  },
];

const stats = [
  {
    icon: "calendar" as const,
    number: "+10",
    label: "ANOS DE ATUAÇÃO",
    description: "Experiência sólida e reconhecimento no mercado.",
  },
  {
    icon: "user" as const,
    number: "100%",
    label: "ATENDIMENTO PERSONALIZADO",
    description: "Soluções jurídicas desenvolvidas para cada clientes.",
  },
  {
    icon: "handshake" as const,
    number: "500+",
    label: "CLIENTES ATENDIDOS",
    description: "Histórias de confiança que se transformam em parcerias.",
  },
  {
    icon: "chart-up" as const,
    number: "RESULTADOS",
    label: "QUE GERAM VALOR",
    description: "Atuação estratégica que protege, previne e gera segurança.",
  },
];
---

<section id="quem-somos" class="about-section">
  <!-- Top Split Area -->
  <div class="about-top">
    <div class="about-top-container">
      <div class="about-content">
        <Title
          badge="QUEM SOMOS"
          headline="Excelência jurídica <br /><span class='gold'>com propósito.</span>"
          padding="0 20px"
        />

        <p class="about-paragraph">
          A GOM Advogados Associados nasceu com o compromisso de oferecer
          soluções jurídicas estratégicas, personalizadas e eficientes.
        </p>

        <p class="about-paragraph">
          Atuamos de forma consultiva e resolutiva, prevenindo riscos e
          construindo segurança para pessoas e empresas.
        </p>

        <!-- 4 Value Pillars Box -->
        <div class="values-box">
          <ValueItem
            icon={values[0].icon}
            title={values[0].title}
            description={values[0].description}
          />
          <div class="value-divider"></div>
          <ValueItem
            icon={values[1].icon}
            title={values[1].title}
            description={values[1].description}
          />
          <div class="value-divider"></div>
          <ValueItem
            icon={values[2].icon}
            title={values[2].title}
            description={values[2].description}
          />
          <div class="value-divider"></div>
          <ValueItem
            icon={values[3].icon}
            title={values[3].title}
            description={values[3].description}
          />
        </div>
      </div>

      <!-- Right Reception Image -->
      <div class="about-visual">
        <Image
          src={recepcaoImg}
          alt="Recepção GOM Advogados Associados"
          widths={[400, 600, 800, 1200]}
          sizes="(min-width: 768px) 560px, 100vw"
          class="reception-image"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Mobile First Base Styles */
  .about-section {
    width: 100%;
    background-color: var(--color-bg-light);
    overflow: hidden;
  }

  .about-top {
    width: 100%;
    background-color: var(--color-bg-light);
  }

  .about-top-container {
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    padding: 0;
  }

  /* Image Column First on Mobile */
  .about-visual {
    order: 1;
    width: 100%;
    height: auto;
    min-height: 260px;
    position: relative;
    border-radius: 0;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    min-width: 0;
  }

  .reception-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Content Column Second on Mobile */
  .about-content {
    order: 2;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    padding: 24px 0 0 0;
  }

  .badge-wrapper {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
  }

  .badge-line {
    width: 32px;
    height: 1px;
    margin: 0.25rem 0;
    background-color: var(--color-gold);
  }

  .badge-text {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--color-gold);
    text-transform: uppercase;
  }

  .about-title {
    font-family: var(--font-serif-display);
    font-size: 2.6rem;
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-text-dark);
    letter-spacing: -0.01em;
  }

  .title-gold {
    color: var(--color-gold);
  }

  .title-divider {
    width: 40px;
    height: 1.5px;
    background-color: var(--color-gold);
    margin: 14px 0 16px 0;
  }

  .about-paragraph {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0 20px;
    line-height: 1.58;
    color: #475569;
    margin-bottom: 10px;
  }

  /* 4 Value Pillars Box */
  .values-box {
    margin-top: 20px;
    background-color: var(--color-card-light);
    border-radius: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    justify-content: space-between;
    padding: 0;
    border: none;
    width: 100%;
    min-width: 0;
  }

  .value-divider {
    display: block;
    width: 1.5px;
    flex-shrink: 0;
    background-color: var(--color-gold);
    margin: 6px 0;
  }

  /* Tablet & Desktop Enhancements (min-width: 768px) */
  @media (min-width: 768px) {
    .about-top-container {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 48px;
      padding: 60px 32px 55px 32px;
      align-items: center;
    }

    .about-content {
      order: 1;
      padding: 0;
    }

    .about-visual {
      order: 2;
      height: 100%;
      min-height: 420px;
      border-radius: 6px;
    }

    .values-box {
      border-radius: 4px;
      border: 1px solid #ede8e0;
    }

    .value-divider {
      width: 1px;
      background-color: #e2dcd2;
      margin: 8px 0;
    }
  }
</style>
