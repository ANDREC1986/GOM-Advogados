---
import { Image } from "astro:assets";
import Icon from "../common/Icon.astro";

interface Props {
  image: ImageMetadata;
  icon: string;
  title: string;
  description: string;
}

const { image, icon, title, description } = Astro.props;
---

<div class="area-card">
  <div class="card-image-wrapper">
    <Image src={image} alt={title} class="card-image" />
  </div>
  <div class="card-content">
    <div class="card-header">
      <div class="card-icon">
        <Icon name={icon} size={22} />
      </div>
      <h3 class="card-title">{title}</h3>
    </div>
    <p class="card-description">{description}</p>
  </div>
</div>

<style>
  .area-card {
    background-color: var(--color-bg-dark-card, #121417);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    border: 1px solid rgba(200, 162, 97, 0.1);
  }

  .area-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
    border-color: rgba(200, 162, 97, 0.3);
  }

  .card-image-wrapper {
    width: 100%;
    height: 100px;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .area-card:hover .card-image {
    transform: scale(1.05);
  }

  .card-content {
    padding: 12px 3px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 8px;
    padding: 0.5rem;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .card-icon {
    color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-icon :global(svg) {
    width: 35px;
    height: 35px;
  }

  .card-title {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-gold);
    text-transform: uppercase;
    margin: 0;
    line-height: 1.3;
  }

  .card-description {
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 400;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  @media (min-width: 768px) {
    .card-image-wrapper {
      height: 160px;
    }
    .card-content {
      padding: 20px 5px;
      gap: 12px;
    }
    .card-icon :global(svg) {
      width: 22px;
      height: 22px;
    }
    .card-title {
      font-size: 0.85rem;
      letter-spacing: 0.1em;
    }
    .card-description {
      font-size: 0.82rem;
      line-height: 1.5;
    }
  }
</style>
