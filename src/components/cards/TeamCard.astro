---
import { Image } from "astro:assets";

interface Props {
  image: ImageMetadata;
  role: string;
  name: string;
  specialty: string;
}

const { image, role, name, specialty } = Astro.props;
---

<div class="team-card">
  <div class="card-image-wrapper">
    <Image src={image} alt={name} class="card-image" draggable="false" />
  </div>
  <div class="card-info">
    <span class="member-role">{role}</span>
    <h3 class="member-name">{name}</h3>
    <div class="member-divider"></div>
    <span class="member-specialty">{specialty}</span>
  </div>
</div>

<style>
  .team-card {
    background-color: var(--color-bg-dark-card, #121417);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 280px; /* Locked width for carousel on mobile */
    flex-shrink: 0;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(200, 162, 97, 0.1);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .team-card:hover {
    transform: translateY(-4px);
    border-color: rgba(200, 162, 97, 0.3);
  }

  .card-image-wrapper {
    width: 100%;
    height: 280px;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    pointer-events: none;
    -webkit-user-drag: none;
    user-drag: none;
  }

  .card-info {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }

  .member-role {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    text-transform: uppercase;
  }

  .member-name {
    font-family: var(--font-serif-display), serif;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-text-white, #ffffff);
    line-height: 1.3;
    margin: 0;
    text-transform: uppercase;
  }

  .member-divider {
    width: 100%;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.15);
    margin: 4px 0;
  }

  .member-specialty {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 400;
  }

  @media (min-width: 768px) {
    .team-card {
      width: 100%; /* Spans full grid column on tablet/desktop */
    }
    
    .card-image-wrapper {
      height: 320px;
    }
  }
</style>
