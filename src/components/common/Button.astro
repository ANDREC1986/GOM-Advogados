---
interface Props {
  text: string;
  href?: string;
  variant?: "gold" | "outline";
  icon?: "whatsapp" | "calendar" | "none";
  className?: string;
}

const {
  text,
  href = "#",
  variant = "gold",
  icon = "none",
  className = "",
} = Astro.props;
---

<a href={href} class:list={["btn", `btn-${variant}`, className]}>
  {
    icon === "whatsapp" && (
      <svg
        class="btn-icon"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="currentColor"
      >
        <path
          transform="scale(0.7)"
          transform-origin="center"
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.572-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347z"
        />
        <path d="M12 2C6.477 2 2 6.477 2 12c0 2.159.682 4.16 1.848 5.804L2.5 21.5l3.816-1.325A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18c-1.802 0-3.486-.477-4.945-1.311l-.354-.204-2.268.788.799-2.207-.227-.367A7.954 7.954 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z" />
      </svg>
    )
  }

  {
    icon === "calendar" && (
      <svg
        class="btn-icon"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
        <line x1="16" y1="2" x2="16" y2="6" />
        <line x1="8" y1="2" x2="8" y2="6" />
        <line x1="3" y1="10" x2="21" y2="10" />
        <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01" />
      </svg>
    )
  }

  <span>{text}</span>
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 28px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 4px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
    max-width: 100%;
  }

  /* Variant Gold (Solid) */
  .btn-gold {
    background-color: var(--color-gold);
    color: #111215;
    border: 1px solid var(--color-gold);
    box-shadow: 0 4px 20px rgba(200, 162, 97, 0.25);
  }

  .btn-gold:hover {
    background-color: var(--color-gold-hover);
    border-color: var(--color-gold-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(200, 162, 97, 0.4);
  }

  /* Variant Outline (Transparent with Gold Border) */
  .btn-outline {
    background-color: transparent;
    color: var(--color-gold);
    border: 1px solid var(--color-gold-border);
  }

  .btn-outline:hover {
    background-color: rgba(200, 162, 97, 0.1);
    border-color: var(--color-gold);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .btn-icon {
    flex-shrink: 0;
  }
</style>
