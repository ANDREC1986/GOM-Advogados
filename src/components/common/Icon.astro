---
interface Props {
  name: string;
  size?: number | string;
  class?: string;
}

const { name, size, class: className = "" } = Astro.props;

// Dynamically import all SVG icons from src/assets/icons and src/assets/how-section as raw SVG strings
const iconFilesIcons = import.meta.glob<string>("../../assets/icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const iconFilesHow = import.meta.glob<string>("../../assets/how-section/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const iconFiles = { ...iconFilesIcons, ...iconFilesHow };

const iconAliasMap: Record<string, string> = {
  scale: "../../assets/icons/balança.svg",
  balanca: "../../assets/icons/balança.svg",
  balança: "../../assets/icons/balança.svg",
  
  chart: "../../assets/how-section/grafico-oscilante.svg",
  grafico: "../../assets/how-section/grafico-oscilante.svg",
  "grafico-oscilante": "../../assets/how-section/grafico-oscilante.svg",

  people: "../../assets/icons/familia.svg",
  familia: "../../assets/icons/familia.svg",
  family: "../../assets/icons/familia.svg",

  building: "../../assets/icons/forum.svg",
  forum: "../../assets/icons/forum.svg",

  shield: "../../assets/how-section/sign.svg",
  "shield-check": "../../assets/how-section/sign.svg",
  "badge-pessoa": "../../assets/how-section/sign.svg",
  "badge pessoa": "../../assets/how-section/sign.svg",

  document: "../../assets/icons/folha com lapis.svg",
  "folha-com-lapis": "../../assets/icons/folha com lapis.svg",
  "folha com lapis": "../../assets/icons/folha com lapis.svg",

  badge: "../../assets/icons/badge.svg",
  calendar: "../../assets/how-section/clock.svg",
  calendario: "../../assets/how-section/clock.svg",
  clock: "../../assets/how-section/clock.svg",
  group: "../../assets/icons/group.svg",
  grow: "../../assets/how-section/grafico-oscilante.svg",
  "chart-up": "../../assets/how-section/grafico-oscilante.svg",
  handshake: "../../assets/icons/handshake.svg",
  person: "../../assets/icons/person.svg",
  user: "../../assets/icons/person.svg",
  sign: "../../assets/how-section/sign.svg",
  target: "../../assets/icons/target.svg",

  // New icons from how-section
  chatballon: "../../assets/how-section/chatballon.svg",
  speech: "../../assets/how-section/chatballon.svg",
  searchtext: "../../assets/how-section/searchtext.svg",
  "check-list": "../../assets/how-section/check-list.svg",
  checklist: "../../assets/how-section/check-list.svg",
};

const pathKey = iconAliasMap[name] || `../../assets/icons/${name}.svg`;
const rawSvg = iconFiles[pathKey] || "";

// Process size or class if provided
let processedSvg = rawSvg;
if (size && processedSvg) {
  processedSvg = processedSvg.replace(
    /<svg /i,
    `<svg width="${size}" height="${size}" `
  );
}
if (className && processedSvg) {
  processedSvg = processedSvg.replace(
    /<svg /i,
    `<svg class="${className}" `
  );
}
---

{processedSvg ? <Fragment set:html={processedSvg} /> : null}
