---
interface Props {
  icon: "shield-check" | "people" | "target" | "award";
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<div class="value-item">
  <div class="value-container">
    <div class="icon-wrapper">
      {
        icon === "shield-check" && (
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            <path d="M9 12l2 2 4-4" />
          </svg>
        )
      }

      {
        icon === "people" && (
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="7" r="3" />
            <circle cx="5" cy="9" r="2.5" />
            <circle cx="19" cy="9" r="2.5" />
            <path d="M5 20v-1a3.5 3.5 0 0 1 3.5-3.5h7a3.5 3.5 0 0 1 3.5 3.5v1" />
          </svg>
        )
      }

      {
        icon === "target" && (
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="10" />
            <circle cx="12" cy="12" r="6" />
            <circle cx="12" cy="12" r="2" />
            <line x1="12" y1="2" x2="12" y2="4" />
            <line x1="12" y1="20" x2="12" y2="22" />
            <line x1="2" y1="12" x2="4" y2="12" />
            <line x1="20" y1="12" x2="22" y2="12" />
          </svg>
        )
      }

      {
        icon === "award" && (
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="8" r="6" />
            <path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11" />
          </svg>
        )
      }
    </div>

    <h4 class="value-title">{title}</h4>
    <p class="value-description">{description}</p>
  </div>
</div>

<style>
  /* Mobile First Base Layout */
  .value-item {
    flex: 1 1 0%;
    width: 0;
    min-width: 0;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    padding: 16px 4px 18px 4px;
    background-color: transparent;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
    border-radius: 4px;
    position: relative;
  }

  .value-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
  }

  .value-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    background-color: var(--color-card-light);
    z-index: 2;
  }

  .icon-wrapper {
    color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-bottom: 8px;
  }

  .icon-wrapper svg {
    width: 34px;
    height: 34px;
  }

  .value-title {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-dark);
    text-align: center;
    margin: 0 0 6px 0;
    padding: 0;
    line-height: 1.2;
  }

  .value-description {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    line-height: 1.32;
    color: #475569;
    width: 100%;
    text-align: center;
    margin: 0;
    padding: 0 2px;
  }

  /* Desktop Enhancements (min-width: 768px) */
  @media (min-width: 768px) {
    .value-item {
      padding: 20px 8px;
    }

    .icon-wrapper svg {
      width: 38px;
      height: 38px;
    }

    .value-title {
      font-size: 0.82rem;
      letter-spacing: 0.07em;
      margin-bottom: 8px;
    }

    .value-description {
      font-size: 0.74rem;
      line-height: 1.4;
    }
  }
</style>
