              />
            </g>
            <g transform="matrix(0.518901,0,0,0.518901,-286.700476,-291.109258)">
              <path
                d="M594.267,575.933L604.142,580.079L608.233,590.089L604.142,600.1L594.267,604.246L584.391,600.1L580.301,590.089L584.391,580.079L594.267,575.933Z"
                style="fill:none;stroke:currentColor;stroke-width:5.14px;stroke-linecap:round;stroke-linejoin:round;"
              />
            </g>
          </svg>
        )
      }
    </div>

    <h4 class="value-title">{title}</h4>
    <p class="value-description">{description}</p>
  </div>
</div>

<style>
  /* Mobile First Base Layout */
  .value-item {
    flex: 1 1 0%;
    width: 0;
    min-width: 0;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    padding: 16px 4px 18px 4px;
    background-color: transparent;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
    border-radius: 4px;
    position: relative;
  }

  .value-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
  }

  .value-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    background-color: var(--color-card-light);
    z-index: 2;
  }

  .icon-wrapper {
    color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-bottom: 8px;
  }

  .icon-wrapper svg {
    width: 34px;
    height: 34px;
  }

  .value-title {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-dark);
    text-align: center;
    margin: 0 0 6px 0;
    padding: 0;
  }

  .value-description {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    line-height: 1.32;
    color: #475569;
    width: 100%;
    text-align: center;
    margin: 0;
    padding: 0;
  }

  /* Desktop Enhancements (min-width: 768px) */
  @media (min-width: 768px) {
    .value-item {
      padding: 20px 8px;
    }

    .icon-wrapper svg {
      width: 38px;
      height: 38px;
    }

    .value-title {
      font-size: 0.82rem;
      letter-spacing: 0.07em;
      margin-bottom: 8px;
    }

    .value-description {
      font-size: 0.74rem;
      line-height: 1.4;
    }
  }
</style>
