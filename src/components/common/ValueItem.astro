              />
            </g>
            <g transform="matrix(0.862619,0,0,0.862619,-220.834288,-490.737007)">
              <path
                d="M257.568,607.269L257.757,597.419C257.757,597.419 257.568,591.926 263.25,591.737L269.312,591.737"
                style="fill:none;stroke:currentColor;stroke-width:3.09px;stroke-linecap:round;stroke-linejoin:round;"
              />
            </g>
            <g transform="matrix(-0.862619,0,0,0.862619,260.177517,-486.100662)">
              <circle
                cx="260.22"
                cy="577.625"
                r="4.83"
                style="fill:none;stroke:currentColor;stroke-width:3.09px;"
              />
            </g>
            <g transform="matrix(-0.862619,0,0,0.862619,264.834288,-490.737007)">
              <path
                d="M257.568,607.269L257.757,597.419C257.757,597.419 257.568,591.926 263.25,591.737L269.312,591.737"
                style="fill:none;stroke:currentColor;stroke-width:3.09px;stroke-linecap:round;stroke-linejoin:round;"
              />
            </g>
            <g transform="matrix(0.862619,0,0,0.862619,-221.549143,-490.737007)">
              <ellipse
                cx="282.476"
                cy="580.845"
                rx="6.748"
                ry="6.985"
                style="fill:none;stroke:currentColor;stroke-width:3.09px;"
              />
            </g>
            <g transform="matrix(0.862619,0,0,0.862619,-219.10905,-490.737007)">
              <path
                d="M269.335,614.93L269.335,599.906C269.335,599.906 269.809,593.729 278.214,593.562L283.187,593.562"
                style="fill:none;stroke:currentColor;stroke-width:3.09px;stroke-linecap:round;stroke-linejoin:round;"
              />
            </g>
            <g transform="matrix(-0.729909,0,0,0.862619,227.560452,-490.737007)">
              <path
                d="M269.335,614.93L269.335,599.906C269.335,599.906 269.809,593.729 278.214,593.562L283.187,593.562"
                style="fill:none;stroke:currentColor;stroke-width:3.34px;stroke-linecap:round;stroke-linejoin:round;"
              />
            </g>
          </svg>
        )
      }

      {
        icon === "target" && (
          <svg viewBox="0 0 44 44" fill="none" stroke="currentColor">
            <g transform="matrix(0.881259,0,0,0.881259,-365.162067,-501.263297)">
              <path
