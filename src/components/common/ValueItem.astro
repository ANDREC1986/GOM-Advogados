                style="fill:none;stroke:currentColor;stroke-width:2.77px;stroke-linecap:round;stroke-linejoin:round;"
              />
            </g>
            <g transform="matrix(0.963253,0,0,0.963253,-550.764092,-553.316646)">
              <path
                d="M594.267,575.933L604.142,580.079L608.233,590.089L604.142,600.1L594.267,604.246L584.391,600.1L580.301,590.089L584.391,580.079L594.267,575.933Z"
