---
interface Props {
  icon: "shield-check" | "people" | "target" | "award";
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<div class="value-item">
  <div class="value-container">
    <div class="icon-wrapper">
      {
        icon === "shield-check" && (
          <svg viewBox="0 0 44 44" fill="none" stroke="currentColor">
            <g transform="matrix(0.977426,0,0,0.929792,-96.462973,-529.888671)">
              <path
                d="M104.092,577.757C104.092,577.757 115.118,579.668 120.903,572.193C120.903,572.193 129.486,578.87 138.839,578.279L138.505,596.885C138.505,596.885 136.885,608.537 121.258,614.93C121.258,614.93 105.556,607.405 104.372,597.105L104.092,577.757"
                style="fill:none;stroke:currentColor;stroke-width:2.8px;stroke-linecap:round;stroke-linejoin:round;"
              />
            </g>
            <g transform="matrix(0.977426,0,0,0.929792,-96.462973,-529.888671)">
              <path
                d="M113.193,593.562L118.781,598.749L130.714,586.721"
                style="fill:none;stroke:currentColor;stroke-width:2.8px;stroke-linecap:round;stroke-linejoin:round;"
              />
            </g>
          </svg>
        )
      }

      {
        icon === "people" && (
          <svg viewBox="0 0 44 44" fill="none" stroke="currentColor">
            <g transform="matrix(0.862619,0,0,0.862619,-216.177517,-486.100662)">
              <circle
                cx="260.22"
