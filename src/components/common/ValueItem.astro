              />
            </g>
          </svg>
        )
      }

      {
        icon === "award" && (
          <svg viewBox="0 0 44 44" fill="none" stroke="currentColor">
            <g transform="matrix(0.963253,0,0,0.963253,-548.09138,-550.822115)">
              <path
                d="M581.248,598.012L573.553,611.955L579.709,611.39L582.314,616.007L590.127,601.656"
                style="fill:none;stroke:currentColor;stroke-width:2.77px;stroke-linecap:round;stroke-linejoin:round;"
              />
            </g>
