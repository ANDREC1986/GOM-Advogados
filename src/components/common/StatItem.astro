---
import Icon from "./Icon.astro";

interface Props {
  icon: "calendar" | "user" | "handshake" | "chart-up";
  number: string;
  label: string;
  description: string;
}

const { icon, number, label, description } = Astro.props;
---

<div class="stat-item">
  <!-- Icon -->
  <div class="stat-icon">
    <Icon name={icon} />
  </div>

  <!-- Mobile Vertical Inner Line 1 (Between Icon and Main) -->
  <div class="inner-divider mobile-only"></div>

  <!-- Left Value Column (Number + Label) -->
  <div class="stat-main">
    <div class="stat-number">{number}</div>
    <div class="stat-label">{label}</div>
  </div>

  <!-- Mobile Vertical Inner Line -->
  <div class="inner-divider mobile-only"></div>

  <!-- Description -->
  <p class="stat-description">{description}</p>
</div>

<style>
  /* Mobile First Base Layout */
  .stat-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    text-align: left;
    padding: 20px 8px;
    gap: 12px;
    width: 100%;
    box-sizing: border-box;
  }

  .desktop-only {
    display: none !important;
  }

  .mobile-only {
    display: flex !important;
  }

  .top-line {
    width: 24px;
    height: 1.5px;
    background-color: var(--color-gold);
    margin-bottom: 4px;
  }

  .stat-icon {
    color: var(--color-gold);
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
  }

  .stat-icon :global(svg) {
    width: 28px;
    height: 28px;
    display: block !important;
    color: var(--color-gold) !important;
  }

  .stat-icon :global(svg path),
  .stat-icon :global(svg circle),
  .stat-icon :global(svg rect),
  .stat-icon :global(svg line) {
    stroke: var(--color-gold) !important;
  }

  .stat-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    text-align: left;
    width: 125px;
    flex: 0 0 125px;
    min-width: 125px;
    max-width: 125px;
    overflow: hidden;
  }

  .stat-number {
    font-family: var(--font-serif-display);
    font-size: 1.9rem;
    font-weight: 500;
    color: var(--color-gold);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .stat-label {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-white);
    margin-top: 4px;
  }

  .inner-divider {
    width: 1px;
    height: 48px;
    background-color: rgba(200, 162, 97, 0.3);
    flex-shrink: 0;
  }

  .stat-description {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.8);
    text-align: left;
    flex: 1 1 0%;
    min-width: 0;
  }

  /* Desktop Enhancements (min-width: 768px) */
  @media (min-width: 768px) {
    .desktop-only {
      display: block !important;
    }

    .mobile-only {
      display: none !important;
    }

    .stat-item {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 16px 8px;
      gap: 8px;
      flex: 1;
      width: auto;
    }

    .stat-icon {
      display: none !important;
    }

    .stat-icon :global(svg) {
      width: 32px !important;
      height: 32px !important;
      display: block !important;
      color: var(--color-gold) !important;
    }

    .stat-main {
      align-items: center;
      text-align: center;
      width: auto;
      flex: initial;
      min-width: auto;
      max-width: none;
      overflow: visible;
    }

    .stat-number {
      font-size: 2.3rem;
      line-height: 1.1;
    }

    .stat-label {
      font-size: 0.68rem;
      letter-spacing: 0.16em;
      margin-top: 2px;
    }

    .stat-description {
      text-align: center;
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.7);
      max-width: 200px;
      flex: initial;
    }
  }
</style>
