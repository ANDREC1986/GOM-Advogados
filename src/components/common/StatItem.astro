---
interface Props {
  icon: 'calendar' | 'user' | 'handshake' | 'chart-up';
  number: string;
  label: string;
  description: string;
}

const { icon, number, label, description } = Astro.props;
---

<div class="stat-item">

  <!-- Mobile Icon -->
  <div class="stat-icon mobile-only">
    {icon === 'calendar' && (
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
        <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01"></path>
      </svg>
    )}

    {icon === 'user' && (
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
    )}

    {icon === 'handshake' && (
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M11 15h2a2 2 0 1 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 17"></path>
        <path d="M7 11l4-4 3 3 5-5"></path>
        <path d="M21 16l-3.5-3.5a1.5 1.5 0 0 0-2.1 0L14 14"></path>
        <circle cx="18" cy="6" r="1.5"></circle>
      </svg>
    )}

    {icon === 'chart-up' && (
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="20" x2="18" y2="10"></line>
        <line x1="12" y1="20" x2="12" y2="4"></line>
        <line x1="6" y1="20" x2="6" y2="14"></line>
        <path d="M3 20h18"></path>
        <path d="M16 6l3 3m0-3l-3 3"></path>
      </svg>
    )}
  </div>

  <!-- Mobile Vertical Inner Line 1 (Between Icon and Main) -->
  <div class="inner-divider mobile-only"></div>

  <!-- Left Value Column (Number + Label) -->
  <div class="stat-main">
    <div class="stat-number">{number}</div>
    <div class="stat-label">{label}</div>
  </div>

  <!-- Mobile Vertical Inner Line -->
  <div class="inner-divider mobile-only"></div>

  <!-- Description -->
  <p class="stat-description">{description}</p>
</div>

<style>
  /* Desktop Default Layout */
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 16px 8px;
    gap: 6px;
    flex: 1;
  }

  .desktop-only {
    display: block;
  }

  .mobile-only {
    display: none;
  }

  .top-line {
    width: 24px;
    height: 1.5px;
    background-color: var(--color-gold);
    margin-bottom: 4px;
  }

  .stat-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .stat-number {
    font-family: var(--font-serif-display);
    font-size: 2.3rem;
    font-weight: 500;
    color: var(--color-gold);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .stat-label {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-white);
    margin-top: 2px;
  }

  .stat-description {
    font-family: var(--font-sans);
    font-size: 0.74rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.7);
    max-width: 200px;
  }

  /* Mobile Layout (Exact Match to Mobile Mockup) */
  @media (max-width: 768px) {
    .desktop-only {
      display: none !important;
    }

    .mobile-only {
      display: flex !important;
    }

    .stat-item {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      text-align: left;
      padding: 22px 12px;
      gap: 16px;
      width: 100%;
    }

    .stat-icon {
      color: var(--color-gold);
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 1 1 0%;
      min-width: 0;
    }

    .stat-main {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      flex: 1 1 0%;
      min-width: 0;
    }

    .stat-number {
      font-size: 1.9rem;
      line-height: 1;
    }

    .stat-label {
      font-size: 0.62rem;
      letter-spacing: 0.12em;
      margin-top: 4px;
    }

    .inner-divider {
      width: 1px;
      height: 48px;
      background-color: rgba(200, 162, 97, 0.3);
      flex-shrink: 0;
    }

    .stat-description {
      text-align: left;
      font-size: 0.78rem;
      line-height: 1.45;
      color: rgba(255, 255, 255, 0.8);
      flex: 2 2 0%;
      min-width: 0;
    }
  }
</style>
