---
import Icon from "./Icon.astro";

interface Props {
  icon: "calendar" | "user" | "handshake" | "chart-up";
  title: string;
  subtitle: string;
  description: string;
}

const { icon, title, subtitle, description } = Astro.props;
---

<div class="stat-item">
  <!-- Icon -->
  <div class="stat-icon">
    <Icon name={icon} />
  </div>

  <!-- Mobile Vertical Inner Line 1 (Between Icon and Main) -->
  <div class="inner-divider mobile-only"></div>

  <!-- Left Value Column (Title + Subtitle) -->
  <div class="stat-main">
    <div class="stat-text-gold">{title}</div>
    <div class="stat-text-gold">{subtitle}</div>
  </div>

  <!-- Mobile Vertical Inner Line -->
  <div class="inner-divider mobile-only"></div>

  <!-- Description -->
  <p class="stat-description">{description}</p>
</div>

<style>
  /* Mobile First Base Layout */
  .stat-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    text-align: left;
    padding: 20px 8px;
    gap: 12px;
    width: 100%;
    box-sizing: border-box;
  }

  .desktop-only {
    display: none !important;
  }

  .mobile-only {
    display: flex !important;
  }

  .stat-icon {
    color: var(--color-gold);
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
  }

  .stat-icon :global(svg) {
    width: 28px;
    height: 28px;
    display: block !important;
    color: var(--color-gold) !important;
  }

  .stat-icon :global(svg path),
  .stat-icon :global(svg circle),
  .stat-icon :global(svg rect),
  .stat-icon :global(svg line) {
    stroke: var(--color-gold) !important;
  }

  .stat-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    text-align: left;
    width: 125px;
    flex: 0 0 125px;
    min-width: 125px;
    max-width: 125px;
    overflow: hidden;
  }

  .stat-text-gold {
    font-family: var(--font-serif-display);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-gold);
    line-height: 1.25;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .inner-divider {
    width: 1px;
    height: 48px;
    background-color: rgba(200, 162, 97, 0.3);
    flex-shrink: 0;
  }

  .stat-description {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.8);
    text-align: left;
    flex: 1 1 0%;
    min-width: 0;
  }

  /* Desktop Enhancements (min-width: 768px) */
  @media (min-width: 768px) {
    .desktop-only {
      display: block !important;
    }

    .mobile-only {
      display: none !important;
    }

    .stat-item {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 16px 8px;
      gap: 8px;
      flex: 1;
      width: auto;
    }

    .stat-icon {
      display: flex !important;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      min-width: 32px;
      min-height: 32px;
      flex: 0 0 32px;
      margin-bottom: 4px;
    }

    .stat-icon {
      display: none !important;
    }

    .stat-main {
      align-items: center;
      text-align: center;
      width: auto;
      flex: initial;
      min-width: auto;
      max-width: none;
      overflow: visible;
    }

    .stat-text-gold {
      font-size: 1.25rem;
      line-height: 1.15;
    }

    .stat-description {
      text-align: center;
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.7);
      max-width: 200px;
      flex: initial;
    }
  }
</style>
