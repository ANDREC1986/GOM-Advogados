            <path d="M445.882,654.968L432.837,640.656C432.837,640.656 426.049,648.414 422.291,645.202C418.532,641.989 428.655,635.564 428.655,635.564C428.655,635.564 437.323,628.23 443.566,632.533C449.809,636.837 451.749,639.746 451.749,639.746C451.749,639.746 455.507,647.167 450.294,651.185C446.536,654.082 445.928,654.795 445.882,654.968ZM445.882,654.968L445.93,655.021C445.93,655.021 445.864,655.035 445.882,654.968Z" style="fill:none;stroke:currentColor;stroke-width:3.18px;stroke-linecap:round;stroke-linejoin:round;"/>
          </g>
          <g transform="matrix(0.626187,-0.557735,0.557735,0.626187,-616.352484,-156.861718)">
            <path d="M416.523,657.664C416.523,658.944 415.483,659.984 414.202,659.984L410.083,659.984C408.803,658.944 407.763,659.984 407.763,657.664C407.763,656.383 408.803,655.343 410.083,655.343L414.202,655.343C415.483,655.343 416.523,656.383 416.523,657.664Z" style="fill:none;stroke:currentColor;stroke-width:3.18px;stroke-linecap:round;stroke-linejoin:round;"/>
          </g>
          <g transform="matrix(0.626187,-0.557735,0.557735,0.626187,-612.998254,-153.507488)">
            <path d="M416.523,657.664C416.523,658.944 415.483,659.984 414.202,659.984L410.083,659.984C408.803,659.984 407.763,658.944 407.763,657.664C407.763,656.383 408.803,655.343 410.083,655.343L414.202,655.343C415.483,655.343 416.523,656.383 416.523,656.383Z" style="fill:none;stroke:currentColor;stroke-width:3.18px;stroke-linecap:round;stroke-linejoin:round;"/>
          </g>
