            <rect x="412.1" y="743.951" width="5.431" height="10.129" style="fill:none;stroke:currentColor;stroke-width:2.67px;stroke-linecap:round;stroke-linejoin:round;"/>
          </g>
          <g transform="matrix(1,0,0,1.520642,-393.490882,-1105.486085)">
            <rect x="412.1" y="743.951" width="5.431" height="10.129" style="fill:none;stroke:currentColor;stroke-width:2.07px;stroke-linecap:round;stroke-linejoin:round;"/>
          </g>
          <g transform="matrix(1,0,0,2.328536,-379.490882,-1714.701867)">
            <rect x="412.1" y="743.951" width="5.431" height="10.129" style="fill:none;stroke:currentColor;stroke-width:1.49px;stroke-linecap:round;stroke-linejoin:round;"/>
          </g>
          <g transform="matrix(1,0,0,1,-406.490882,-712.880359)">
            <path d="M411.335,737.757L443.4,717.088L434.492,715.681" style="fill:none;stroke:currentColor;stroke-width:2.67px;stroke-linecap:round;stroke-linejoin:round;"/>
          </g>
          <g transform="matrix(1,0,0,1,-406.490882,-712.880359)">
            <path d="M441.816,725.634L443.4,717.088" style="fill:none;stroke:currentColor;stroke-width:2.67px;stroke-linecap:round;stroke-linejoin:round;"/>
          </g>
        </svg>
      )
    }
  </div>

  <!-- Mobile Vertical Inner Line 1 (Between Icon and Main) -->
  <div class="inner-divider mobile-only"></div>

  <!-- Left Value Column (Title + Subtitle in Gold Serif Display Number Style with same font size & no wrapping) -->
  <div class="stat-main">
    <div class="stat-text-gold">{title}</div>
    <div class="stat-text-gold">{subtitle}</div>
  </div>

  <!-- Mobile Vertical Inner Line -->
  <div class="inner-divider mobile-only"></div>

  <!-- Description -->
  <p class="stat-description">{description}</p>
</div>

<style>
  /* Mobile First Base Layout */
  .stat-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    text-align: left;
    padding: 20px 8px;
    gap: 12px;
    width: 100%;
    box-sizing: border-box;
  }

  .desktop-only {
    display: none !important;
  }

  .mobile-only {
    display: flex !important;
  }

  .stat-icon {
    color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    flex: 0 0 28px;
  }

  .stat-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    text-align: left;
    width: 125px;
    flex: 0 0 125px;
    min-width: 125px;
    max-width: 125px;
    overflow: hidden;
  }

  .stat-text-gold {
    font-family: var(--font-serif-display);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-gold);
    line-height: 1.25;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .inner-divider {
    width: 1px;
    height: 48px;
    background-color: rgba(200, 162, 97, 0.3);
    flex-shrink: 0;
  }

  .stat-description {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.8);
    text-align: left;
    flex: 1 1 0%;
    min-width: 0;
  }

  /* Desktop Enhancements (min-width: 768px) */
  @media (min-width: 768px) {
    .desktop-only {
      display: block !important;
    }

    .mobile-only {
      display: none !important;
    }

    .stat-item {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 16px 8px;
      gap: 6px;
      flex: 1;
      width: auto;
    }

    .stat-main {
      align-items: center;
      text-align: center;
      width: auto;
      flex: initial;
      min-width: auto;
      max-width: none;
      overflow: visible;
    }

    .stat-text-gold {
      font-size: 1.25rem;
      line-height: 1.15;
    }

    .stat-description {
      text-align: center;
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.7);
      max-width: 200px;
      flex: initial;
    }
  }
</style>
