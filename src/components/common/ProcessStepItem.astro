---
import Icon from "./Icon.astro";

interface Props {
  number: number | string;
  icon: string;
  title: string;
  description: string;
  imageSrc: string | ImageMetadata;
  imageAlt?: string;
}

const {
  number,
  icon,
  title,
  description,
  imageSrc,
  imageAlt = title,
} = Astro.props;

// Handle both static string paths and imported ImageMetadata objects
const imgSrc = typeof imageSrc === "string" ? imageSrc : imageSrc.src;
---

<div class="process-step-item">
  <!-- Top Thumbnail Image -->
  <div class="step-image-wrapper">
    <img src={imgSrc} alt={imageAlt} class="step-image" loading="lazy" />
  </div>

  <!-- Outer Card Wrapper -->
  <div class="step-card-wrapper">
    <!-- Number Circle Badge -->
    <div class="step-number-badge">{number}</div>

    <!-- The White/Ivory Card Box -->
    <div class="step-card-box">
      <!-- Icon inside card -->
      <div class="step-icon-wrapper">
        <Icon name={icon} />
      </div>

      <!-- Text Content inside card -->
      <div class="step-content">
        <h3 class="step-title">{title}</h3>
        <div class="yellow-line-desktop"></div>
        <p class="step-description">{description}</p>
      </div>
    </div>
  </div>
</div>

<style>
  /* --------------------------------------------------
     DESKTOP VIEW (default >= 900px): Vertical Column Card
     -------------------------------------------------- */
  .process-step-item {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    position: relative;
    box-sizing: border-box;
  }

  .step-image-wrapper {
    width: 100%;
    height: 130px;
    border-radius: 8px 8px 0 0;
    overflow: hidden;
    position: relative;
    z-index: 1;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
  }

  .step-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .step-card-wrapper {
    position: relative;
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-left: 0;
  }

  /* Black Circle Badge Container: Using lining-nums for 100% baseline alignment */
  .step-number-badge {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translate(-50%, -50%);
    width: 34px;
    height: 34px;
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1 !important;
    background-color: var(--color-bg-dark); /* #0a0b0d */
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-gold);
    font-family: var(--font-sans);
    font-variant-numeric: lining-nums tabular-nums !important;
    font-feature-settings: "lnum" 1 !important;
    font-size: 1rem;
    font-weight: 700;
    z-index: 5;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .step-card-box {
    width: 100%;
    height: 100%;
    background-color: var(--color-card-light); /* #f7f4ee */
    border: 1px solid rgba(200, 162, 97, 0.18);
    border-radius: 0 0 8px 8px;
    padding: 26px 8px 16px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
    box-sizing: border-box;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .process-step-item:hover .step-card-box {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }

  .step-icon-wrapper {
    width: 42px;
    height: 42px;
    min-width: 42px;
    flex: 0 0 42px;
    color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0.5rem auto;
  }

  .step-icon-wrapper :global(svg) {
    width: 42px;
    height: 42px;
  }

  .step-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
    flex: 1;
    min-width: 0;
  }

  .step-title {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    max-width: min-content;
    text-transform: uppercase;
    color: var(--color-text-dark);
    text-align: center;
    line-height: 1.2;
    margin: 0;
  }

  .step-description {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.35;
    color: var(--color-text-dark);
    text-align: center;
    margin: 0;
  }
  .yellow-line-desktop {
    background-color: var(--color-gold);
    height: 1px;
    width: 60px;
    margin: 0.5rem 0;
  }
  /* --------------------------------------------------
     MOBILE VIEW (< 900px): Horizontal Row Card
     -------------------------------------------------- */
  @media (max-width: 899px) {
    .process-step-item {
      flex-direction: row;
      align-items: center;
      height: auto;
    }
    .yellow-line-desktop {
      display: none;
    }

    .step-image-wrapper {
      width: 74px;
      height: 74px;
      min-width: 74px;
      max-width: 74px;
      flex: 0 0 64px;
      border-radius: 8px;
    }

    .step-card-wrapper {
      margin-left: 24px;
      flex-direction: row;
    }

    .step-number-badge {
      left: 0;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 28px;
      height: 28px;
      margin: 0 !important;
      padding: 0 !important;
      line-height: 1 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      text-align: center !important;
      font-family: var(--font-sans) !important;
      font-variant-numeric: lining-nums tabular-nums !important;
      font-feature-settings: "lnum" 1 !important;
      font-size: 0.85rem !important;
    }

    .step-card-box {
      border-radius: 8px;
      padding: 10px 12px 10px 22px;
      flex-direction: row;
      text-align: left;
      align-items: center;
      gap: 12px;
    }

    .step-icon-wrapper {
      width: 32px;
      height: 32px;
      min-width: 32px;
      flex: 0 0 32px;
      margin: 0;
    }

    .step-icon-wrapper :global(svg) {
      width: 32px;
      height: 32px;
    }

    .step-content {
      align-items: flex-start;
      text-align: left;
      gap: 4px;
    }

    .step-title {
      font-size: 0.88rem;
      text-align: left;
    }

    .step-description {
      font-size: 0.86rem;
      text-align: left;
    }
  }
</style>
