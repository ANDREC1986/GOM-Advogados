---
import Protector from "../components/common/Protector.astro";
import SEO from "../SEO/SEO.astro";
import Favicon from "../SEO/Favicon.astro";
import OpenGraph from "../SEO/OpenGraph.astro";
import TwitterCard from "../SEO/TwitterCard.astro";
import "../styles/style.css";

interface Props {
  title?: string;
}

const { title = "GOM Advogados | Soluções Jurídicas Estratégicas" } =
  Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Bloqueio de indexação para ambiente de teste/desenvolvimento -->
    <meta name="robots" content="noindex, nofollow" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- Componentes de SEO (Comentados para serem ativados em produção) -->
    <!-- <Favicon /> -->
    <!-- <SEO /> -->
    <!-- <OpenGraph /> -->
    <!-- <TwitterCard /> -->

    <Protector />
  </head>
  <body>
    <slot />
  </body>
</html>
